datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  uid       String   @unique
  password  String
  role      String   @default("user") // "admin" or "user"
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  uid       String
  token     String   @unique
  createdAt DateTime @default(now())
}

model DataRecord {
  id        Int      @id @default(autoincrement())
  email     String?
  phone     String?
  password  String?
  notes     String?
  rating    Int      @default(0)
  createdAt DateTime @default(now())
}
